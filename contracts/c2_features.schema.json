{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2 output - biomechanical feature row for one delivery",
  "type": "object",
  "required": ["video_id", "bowler_id", "events", "features"],
  "properties": {
    "video_id": { "type": "string" },
    "bowler_id": { "type": "string" },
    "events": {
      "type": "object",
      "description": "Frame indices of delivery events",
      "properties": {
        "bfc_frame": { "type": "integer" },
        "ffc_frame": { "type": "integer" },
        "release_frame": { "type": "integer" }
      }
    },
    "features": {
      "type": "object",
      "description": "Feature name -> value (degrees), published threshold, breach flag, and whether C1 marked the keypoints it uses as reliable",
      "additionalProperties": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": { "type": ["number", "null"] },
          "threshold": { "type": ["number", "null"] },
          "breach": { "type": "boolean" },
          "reliable": { "type": "boolean" },
          "source": { "type": "string" }
        }
      }
    }
  }
}
